<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Kiosk theme: no action bar, no window chrome, black behind the WebView so
         there is no flash of white while the dashboard loads. -->
    <style name="Theme.JanusOmega" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/janus_purple</item>
        <item name="colorPrimaryVariant">@color/janus_purple</item>
        <item name="colorAccent">@color/janus_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/janus_bg</item>
        <item name="android:navigationBarColor">@color/janus_bg</item>
        <item name="android:windowBackground">@color/janus_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

</resources>
