{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.local/schemas/aria-knowledge-record-1.0.0.json",
  "title": "Aria Knowledge Record",
  "description": "A portable, provenance-aware knowledge item organized by the Multicolored Hat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "title",
    "content",
    "hat_ids",
    "epistemic_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "enum": [
        "fact",
        "concept",
        "procedure",
        "reference",
        "observation",
        "question",
        "correction",
        "summary"
      ],
      "default": "reference"
    },
    "hat_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "red",
          "orange",
          "yellow",
          "green",
          "blue",
          "purple",
          "black",
          "white",
          "brown",
          "rainbow"
        ]
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "verified",
        "reviewed",
        "unverified",
        "disputed",
        "superseded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_method": {
      "type": "string",
      "maxLength": 500
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "retrieved_at"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "user",
              "file",
              "official_documentation",
              "standard",
              "research_publication",
              "web_page",
              "measurement",
              "model_generated",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string",
            "description": "Stable ID for an original artifact in a host such as OmniVault."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "quoted_locator": {
            "type": "string",
            "description": "Page, section, line, timestamp, or other locator within the source."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "handling": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "sensitive"
      ],
      "default": "internal"
    },
    "project_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "const": "verified"
          }
        },
        "required": [
          "epistemic_status"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          }
        },
        "required": [
          "sources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "const": "disputed"
          }
        },
        "required": [
          "epistemic_status"
        ]
      },
      "then": {
        "required": [
          "review_notes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "type": "number"
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "required": [
          "confidence_method"
        ]
      }
    }
  ]
}
