hidden = ["target", ".cargo"]

entrypoint = "src/main.rs"
modules = ["rust-stable"]

[nix]
channel = "stable-24_05"
packages = ["jq", "openssl", "pkg-config", "udev", "android-tools", "libimobiledevice", "nvidia-docker"]

[gitHubImport]
requiredFiles = [".replit"]

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Application"

[[workflows.workflow]]
name = "Run Application"
author = "agent"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-janus.sh"

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/run-janus.sh"]

[[ports]]
localPort = 5000
externalPort = 80
